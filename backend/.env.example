# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bnd-foundation

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# API
API_VERSION=v1

# JWT
JWT_ACCESS_SECRET=change-this-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed — first SUPER_ADMIN (run: npm run seed -w backend)
SEED_SUPER_ADMIN_EMAIL=admin@bndfoundation.org
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin

# Google reCAPTCHA v2 — optional while RECAPTCHA_ENABLED is false
# https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha.-what-should-i-do
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMFIbcAVMVRx

# Frontend URL (Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:5173

# Stripe — test keys from https://dashboard.stripe.com/test/apikeys
# Secret key only (never put sk_ in frontend)
STRIPE_SECRET_KEY=sk_test_...
# Optional locally; required for production webhooks. Stripe CLI: stripe listen --forward-to localhost:5000/api/v1/donations/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
