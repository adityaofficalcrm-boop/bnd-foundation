# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bnd-foundation

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# API
API_VERSION=v1

# JWT
JWT_ACCESS_SECRET=change-this-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed — first SUPER_ADMIN (run: npm run seed -w backend)
SEED_SUPER_ADMIN_EMAIL=admin@bndfoundation.org
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
